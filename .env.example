# Copy to .env and fill in. NEVER commit .env.

# Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional: free Himalayas API key (raises rate limits; the source works without it)
HIMALAYAS_API_KEY=

# Google Sheet ID (the long string in the sheet URL between /d/ and /edit)
SHEET_ID=

# Service account credentials. Use ONE of the two:
# a) path to the downloaded JSON key file (keep it outside git or in a git-ignored path)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# b) the full JSON contents as a single line (used in GitHub Actions secrets)
GOOGLE_SERVICE_ACCOUNT_JSON=
